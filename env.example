# หลังจากเชื่อม Upstash Redis ผ่าน Vercel Storage แล้ว
# ตัวแปร 2 ตัวนี้จะถูกใส่ให้อัตโนมัติเวลา deploy บน Vercel
# ไฟล์นี้ (.env.local) ใช้เฉพาะตอนรันในเครื่องตัวเอง (npm run dev)
# ก็อปค่าจริงจากหน้า Vercel dashboard > โปรเจกต์ > Settings > Environment Variables มาใส่แทน

KV_REST_API_URL=
KV_REST_API_TOKEN=
